# Plantilla de configuración. Copie este archivo a `.env` y rellene los valores;
# `.env` está ignorado por git, así que nada de lo que ponga allí se publica.
#
# scripts/generar-environment.mjs lee estas variables antes de cada build, serve y
# test, y con ellas escribe src/environments/environment.ts y environment.prod.ts
# (ambos generados, ninguno versionado). En Vercel se definen en el panel del
# proyecto en vez de en un archivo.

# URL pública del backend. Sin definir, apunta al backend local.
API_BASE=http://localhost:8089

# Habilita el mapa estático del domicilio en la ficha del cliente. Sin definir, la
# ficha cae al mapa propio y el botón «Cómo llegar» sigue funcionando igual.
#
# Restrínjala por dominio (referente HTTP) en la consola de Google: la clave viaja
# al navegador por diseño y Static Maps se factura por petición, de modo que la
# restricción es la única protección real.
GOOGLE_MAPS_API_KEY=
